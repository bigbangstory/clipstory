# Copy to .env and fill in. Never commit .env.

# --- required ---------------------------------------------------------------

# Signs sessions and login links. Generate with:  openssl rand -hex 32
# Changing it signs everyone out, which is the way to revoke all sessions.
SECRET_KEY=

# Postgres password for the bundled database container.
# Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Comma-separated. These addresses are invited automatically and become admins
# on first sign-in, so a fresh deployment has someone who can invite the team.
ADMIN_EMAILS=you@yourcompany.com

# The public URL. Login links are built from this, so it must match what the
# browser actually uses, including https.
BASE_URL=https://clips.yourcompany.com

# --- transcription (defaults are fine) --------------------------------------

# faster-whisper | disabled
TRANSCRIPTION_PROVIDER=faster-whisper
# tiny | base | small | medium. base is the right start on a 2-core ARM box;
# small is noticeably more accurate and roughly twice as slow.
WHISPER_MODEL_SIZE=base
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# TRANSCRIPTION_TIMEOUT_SECONDS=10800

# --- clip suggestions (defaults are fine) -----------------------------------

# ollama | anthropic | disabled
# ollama runs a local model on this machine: free, nothing leaves the server.
SUGGEST_PROVIDER=ollama
# Model name. For ollama this is what `ollama pull` fetches on first start.
# For anthropic, leave empty for the default (claude-opus-5).
SUGGEST_MODEL=qwen2.5:7b-instruct
# Context window for the local model. Long transcripts are windowed to fit.
# Bigger costs RAM; 16384 is comfortable on 12 GB alongside Whisper.
# OLLAMA_NUM_CTX=16384
# Only needed when SUGGEST_PROVIDER=anthropic. Costs per video.
# ANTHROPIC_API_KEY=
# How many clips to ask for per video.
# SUGGESTION_COUNT=8
# SUGGEST_TIMEOUT_SECONDS=1800

# --- email (optional during testing) ----------------------------------------

# Without this, sign-in links are written to the web log instead of emailed.
# Read them with:  docker compose logs web | grep "SIGN-IN LINK"
# Set it before inviting anyone who cannot read the server logs.
RESEND_API_KEY=
MAIL_FROM=Clipstory <onboarding@resend.dev>

# --- tuning (sensible defaults, change only with a reason) ------------------

# Refuse uploads larger than this. 8GB comfortably covers 1 hour at 1080p.
# MAX_UPLOAD_BYTES=8589934592

# Clips and the job are purged this many days after rendering. The source
# video is kept until you press Finalise, so you can keep tweaking.
# CLIP_RETENTION_DAYS=30

# Uvicorn worker processes for the web container.
# WEB_WORKERS=2

# LOG_LEVEL=INFO
