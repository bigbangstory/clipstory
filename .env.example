# Copy to .env and fill in. Never commit .env.

# --- required ---------------------------------------------------------------

# Signs sessions and login links. Generate with:  openssl rand -hex 32
# Changing it signs everyone out, which is the way to revoke all sessions.
SECRET_KEY=

# Postgres password for the bundled database container.
# Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Comma-separated. These addresses are invited automatically and become admins
# on first sign-in, so a fresh deployment has someone who can invite the team.
ADMIN_EMAILS=you@yourcompany.com

# The public URL. Login links are built from this, so it must match what the
# browser actually uses, including https.
BASE_URL=https://clips.yourcompany.com

# --- email (optional during testing) ----------------------------------------

# Without this, sign-in links are written to the worker log instead of emailed.
# That is deliberate: it lets you sign in and test before any email account
# exists. Read them with:  docker compose logs web | grep "SIGN-IN LINK"
# Set it before inviting anyone who cannot read the server logs.
RESEND_API_KEY=
MAIL_FROM=Clipstory <onboarding@resend.dev>

# --- tuning (sensible defaults, change only with a reason) ------------------

# Refuse uploads larger than this. 8GB comfortably covers 1 hour at 1080p.
# MAX_UPLOAD_BYTES=8589934592

# Clips are deleted this many days after rendering.
# CLIP_RETENTION_DAYS=30

# Delete the source video once its clips render. The source is the expensive
# object; set to false only if you re-cut the same video often.
# DELETE_SOURCE_AFTER_RENDER=true

# Uvicorn worker processes for the web container.
# WEB_WORKERS=2

# LOG_LEVEL=INFO
